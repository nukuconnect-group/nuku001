# THIS FILE LISTS the environment variables expected by the frontend.
# Do NOT store secrets in this file. Fill these values in your hosting provider
# (Vercel, Netlify, Render, Cloudflare Pages) or in a local .env.local which is
# excluded by .gitignore.

# Public / client-safe values (placeholders)
VITE_SUPABASE_URL=https://<your-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon-publishable-key>
VITE_SUPABASE_PROJECT_ID=<project-ref>
VITE_CLOUDFLARE_OG_PROXY=false

# Server-side secrets must never be placed in frontend env files. Put them in server
# environments / Supabase dashboard / GitHub Secrets as appropriate.
# Examples of server-side secrets: SUPABASE_SERVICE_ROLE_KEY, PAYGATE_API_KEY,
# MONEROO_WEBHOOK_SECRET, SMTP_PASSWORD, etc.
